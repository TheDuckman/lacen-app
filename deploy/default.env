# -------------------------------------------------------
# Production environment — copy to .env and fill in values
# -------------------------------------------------------

# Node environment — keep "production" on the server
NODE_ENV=production

# Port the Express server listens on inside the container
PORT=3000

# Path to compiled R scripts inside the container (do NOT change)
SCRIPTS_PATH=dist/scripts

# Persistent workspace root (mapped via Docker volume)
SAVED_FILES_PATH=saved-files

# -------------------------------------------------------
# WGCNA / LACEN tuning — adjust to server hardware
# MAXBLOCKSIZE: 5000 for small VMs, 30000 for large ones
# NUM_CORES:    set to the number of CPU cores (nproc)
# -------------------------------------------------------
INIT_MAXBLOCKSIZE=30000
INIT_NUM_CORES=4

# -------------------------------------------------------
# CORS — must match the exact origin of the frontend
# e.g. https://your-app.netlify.app   (no trailing slash)
# -------------------------------------------------------
BASE_URL_FRONT=https://your-frontend.netlify.app
